{
  "schemaVersion": 1,
  "sourceBranch": "main",
  "upstreamRemote": "upstream",
  "upstreamUrl": "https://github.com/Wei-Shaw/sub2api.git",
  "upstreamBranch": "main",
  "upstreamMainRef": "upstream/main",
  "tagPattern": "^v\\d+\\.\\d+\\.\\d+$",
  "proxyUrl": "http://127.0.0.1:10808",
  "maxRepairAttempts": 2,
  "requiredFiles": [
    "backend/internal/service/setting_public.go",
    "backend/internal/service/ops_homepage_status.go",
    "backend/internal/service/ops_public_status.go",
    "frontend/src/views/HomeView.vue",
    "frontend/src/views/user/ExternalRechargeView.vue",
    "frontend/src/views/auth/__tests__/DefaultLoginRedirect.spec.ts",
    "frontend/public/logo.png",
    "frontend/public/community-placeholder.jpg",
    "backend/internal/web/embed_on.go",
    "README.md"
  ],
  "protectedChecks": [
    {
      "path": "backend/internal/config/config.go",
      "contains": [
        "frame-src https://challenges.cloudflare.com",
        "https://pay.ldxp.cn"
      ]
    },
    {
      "path": "backend/internal/service/setting_public.go",
      "contains": [
        "filterUserVisibleMenuItems",
        "GetPublicSettingsForInjection"
      ]
    },
    {
      "path": "backend/internal/service/ops_homepage_status.go",
      "contains": [
        "GetPublicHomepageStatus",
        "PublicHomepageStatusSnapshot"
      ]
    },
    {
      "path": "backend/internal/service/ops_public_status.go",
      "contains": [
        "GetPublicConcurrency",
        "PublicConcurrencyStatus"
      ]
    },
    {
      "path": "frontend/src/views/HomeView.vue",
      "contains": [
        "https://pay.ldxp.cn/shop/1WGCPCG0",
        "https://api.zhouz.online/custom/usage-leaderboard",
        "/community-placeholder.jpg"
      ]
    },
    {
      "path": "frontend/src/router/index.ts",
      "contains": [
        "path: '/home'",
        "path: '/recharge'",
        "requiresAuth: true"
      ]
    },
    {
      "path": "frontend/src/views/user/ExternalRechargeView.vue",
      "contains": [
        "https://pay.ldxp.cn/shop/1WGCPCG0"
      ]
    },
    {
      "path": "frontend/src/views/auth/__tests__/DefaultLoginRedirect.spec.ts",
      "contains": [
        "uses /home for every login entry and callback fallback",
        "'/home'"
      ]
    },
    {
      "path": "backend/internal/web/embed_on.go",
      "contains": [
        "cacheTTL",
        "Apply custom branding before the browser paints"
      ]
    },
    {
      "path": "README.md",
      "contains": [
        "zhouz.online",
        "usage-leaderboard",
        "https://pay.ldxp.cn"
      ]
    }
  ],
  "validationSteps": [
    {
      "name": "git-diff-check",
      "executable": "git",
      "workingDirectory": ".",
      "arguments": ["diff", "HEAD", "--check"]
    },
    {
      "name": "frontend-tests",
      "executable": "pnpm",
      "workingDirectory": ".",
      "arguments": ["--dir", "frontend", "run", "test:run"]
    },
    {
      "name": "frontend-typecheck",
      "executable": "pnpm",
      "workingDirectory": ".",
      "arguments": ["--dir", "frontend", "run", "typecheck"]
    },
    {
      "name": "frontend-lint",
      "executable": "pnpm",
      "workingDirectory": ".",
      "arguments": ["--dir", "frontend", "run", "lint:check"]
    },
    {
      "name": "frontend-build",
      "executable": "pnpm",
      "workingDirectory": ".",
      "arguments": ["--dir", "frontend", "run", "build"]
    },
    {
      "name": "backend-custom-service-tests",
      "executable": "go",
      "workingDirectory": "backend",
      "arguments": ["test", "-tags", "unit", "./internal/service", "-run", "TestSettingService_GetPublicSettings_|TestOpsService_GetPublic"]
    },
    {
      "name": "backend-embed-tests",
      "executable": "go",
      "workingDirectory": "backend",
      "arguments": ["test", "-tags", "embed", "./internal/web"]
    },
    {
      "name": "leaderboard-tests",
      "executable": "go",
      "workingDirectory": "D:\\Desktop\\sub2api\\sub2api-leaderboard",
      "arguments": ["test", "./..."]
    }
  ]
}
